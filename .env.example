# ReviewLens 2.0 configuration. Copy to .env (git-ignored) and fill in. Never commit real credentials.
# Spring Boot reads this file automatically (project root or backend/); start-all.ps1 creates it on first run.

# ---------- MongoDB (local server or MongoDB Atlas) ----------
MONGODB_URI=mongodb://localhost:27017/?serverSelectionTimeoutMS=5000&connectTimeoutMS=5000
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&serverSelectionTimeoutMS=5000
MONGODB_DATABASE=reviewlens

# ---------- Security ----------
# At least 32 random characters. If empty, a random per-process secret is used (sessions end on restart).
JWT_SECRET=
JWT_EXPIRATION_HOURS=24
JWT_ADMIN_EXPIRATION_HOURS=8

# ---------- Python NLP service ----------
NLP_SERVICE_URL=http://localhost:8000

# ---------- First administrator ----------
# Created on startup ONLY while no administrator exists. Password: minimum 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# ---------- Optional ----------
# UPLOAD_DIR=uploads
# REPORTS_DIR=reports
# MAX_REVIEWS=2000000
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174

